# 复制为仓库根目录的 .env（docker compose 会自动读取），按需修改。
# cp docker/.env.example .env

# openclaw 网关地址。
#  - Linux + network_mode: host（默认）：网关在本机 → ws://127.0.0.1:18789/gateway
#  - Docker Desktop(Mac/Win)：改成 ws://host.docker.internal:18789/gateway，并去掉 compose 里的 network_mode: host
GATEWAY_WS_URL=ws://127.0.0.1:18789/gateway
