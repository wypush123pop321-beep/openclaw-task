# 本机私有凭据(真值仅本机,勿提交/勿进 PR)。复制为 configs/local.env 并填入真值。
# 加载方式:oneclick_run.sh source;各 python 脚本经 scripts/local_env.py 读取。

# 华为内网认证代理(密码含 @,URL 编码 %40%40;proxysg-spl 不是 proxyde-spl)
WCX_PROXY=http://<user>:<pwd_urlencoded>@proxysg-spl.huawei.com:8080

# openclaw 网关 gateway.auth.token(批跑 config 的 api_key / WS 认证)
WCX_GATEWAY_TOKEN=<gateway-token>

# simulator 子进程用代理(一般与 WCX_PROXY 相同;run_batch 传给 harness)
SIMULATOR_PROXY=http://<user>:<pwd_urlencoded>@proxysg-spl.huawei.com:8080
