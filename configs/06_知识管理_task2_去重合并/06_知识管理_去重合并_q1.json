{
  "_comment": "AutomationConfig·真实文件环境。D/ 为真实文件树(笔记库),MAP_Windows.json 为文件系统映射,env_config.json 为机器快照。solver 需用文件/代码工具读真实 .md。含 noise 前缀(前置口语干扰)。",
  "system": {
    "platform": [
      "windows"
    ],
    "python": "3.12",
    "tools": []
  },
  "input_dir": {
    "skill_dir": "skills/skill_localize/skills_library",
    "agent_dir": "agents",
    "user_dir": {
      "path": "configs/06_知识管理_task2_去重合并",
      "profile_file": "user_profile_6_研究员笔记库.json",
      "map_file": "MAP_Windows"
    }
  },
  "agents": [
    {
      "name": "assistant1",
      "role": "solver",
      "config": [
        "TOOLS.md"
      ],
      "skills": [],
      "system_prompt": null,
      "model": "deepseek-v4-pro"
    },
    {
      "name": "evaluator",
      "config": [],
      "skills": [],
      "model": "gemini-3-flash-preview",
      "model_provider": "custom-yibuapi-com"
    }
  ],
  "_note_evaluator": "evaluator 已由轨迹生产管线提供,这里只在 queries[].evaluate 里按名字引用并交 rubrics。",
  "queries": [
    {
      "agent_name": "assistant1",
      "text": "哎这阵子忙得脚不沾地,出差刚回来,顺手帮我收拾下笔记库哈。\n\n我 D 盘笔记库里有个《AI论文阅读笔记.md》,批量导入后好像混进了重复的论文笔记(同一篇被不同时间记了好几次,说法略有出入)。帮我读一下文件、把重复的找出来——判断标准是两篇得同时撞上至少 3 个相同的标志性信息(比如作者加年份、专有名词、具体数值或比例),标题、关键词、摘要一起看。每对重复的留一篇就行,告诉我留哪篇、为啥。\n\n结果给我一份 JSON 合并日志:duplicate_pairs 里每对带上 notes、keep、reason,再列个 unique_notes 放没重复的。",
      "is_noise": false,
      "session_name": "query1",
      "timeout": 3600,
      "evaluate": {
        "evaluator_agent": "evaluator",
        "evaluate_every_n_turns": 1,
        "feedback_to_user": true,
        "oracle_ref": "oracle.json",
        "rubrics_ref": "user_queries.json#/0/evaluate/0/custom_rubrics",
        "scoring": {
          "gate_zero": true,
          "weights": {
            "correctness": 0.7,
            "provenance": 0.0,
            "process": 0.2,
            "soft": 0.1
          }
        }
      }
    }
  ],
  "gateway_ws_url": "ws://127.0.0.1:18789/gateway",
  "api_key": null,
  "workspace_base": "~/.openclaw/workspace",
  "simulator_config": "configs/user_proxy_model.json"
}