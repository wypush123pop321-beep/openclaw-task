  "_comment": "AutomationConfig·真实文件环境。Task1: 描述统计与Pearson相关分析，数据放在真实 D 盘 xlsx(D/论文数据/调研数据.xlsx)，solver 需用文件/代码工具读真实表，无noise（干净基线）。",
  "system": {
    "platform": [
      "windows"
    ],
    "python": "3.12",
    "tools": []
  },
  "input_dir": {
    "skill_dir": "skills/skill_localize/skills_library",
    "agent_dir": "agents",
    "user_dir": {
      "path": "configs/08_科研助手_task1_描述统计与相关分析",
      "profile_file": "user_profile_08_经济学硕士生_Stats.json",
      "map_file": "MAP_Windows"
    }
  },
  "agents": [
    {
      "name": "assistant1",
      "role": "solver",
      "config": [
        "TOOLS.md"
      ],
      "skills": [],
      "system_prompt": null,
      "model": "deepseek-v4-pro"
    },
    {
      "name": "evaluator",
      "config": [],
      "skills": [],
      "model": "gemini-3-flash-preview",
      "model_provider": "custom-yibuapi-com"
    }
  ],
  "_note_evaluator": "evaluator不在这里定义:已由轨迹生产管线提供。我们只在queries[].evaluate里按名字引用并交出custom_rubrics。",
  "queries": [
    {
      "agent_name": "assistant1",
      "text": "我D盘论文数据文件夹里有个《调研数据.xlsx》，20个受访者的受教育年限、工龄和月薪。帮我算下这三项各自的均值和样本标准差，再看看两两之间（学历跟月薪、工龄跟月薪、学历跟工龄）的相关性，哪对显著哪对不显著。结果我要写进毕业论文的，得准。",
      "is_noise": false,
      "session_name": "query1",
      "timeout": 3600,
      "evaluate": {
        "evaluator_agent": "evaluator",
        "evaluate_every_n_turns": 1,
        "feedback_to_user": true,
        "oracle_ref": "oracle.json",
        "rubrics_ref": "user_queries.json#/0/evaluate/0/custom_rubrics",
        "scoring": {
          "gate_zero": true,
          "weights": {
            "correctness": 0.55,
            "provenance": 0.2,
            "process": 0.15,
            "soft": 0.1
          }
        }
      }
    }
  ],
  "gateway_ws_url": "ws://127.0.0.1:18789/gateway",
  "api_key": null,
  "workspace_base": "~/.openclaw/workspace",
  "simulator_config": "configs/user_proxy_model.json"
}